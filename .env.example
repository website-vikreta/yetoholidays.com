# Copy to .env.local and fill in. Never commit .env.local.

# Public site details. Leave empty to hide the matching button or line.
NEXT_PUBLIC_SITE_URL=https://yetoholidays.com
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=

# Bank details, used by the booking confirmation step only (server side).
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IFSC=
BANK_NAME=

# Supabase (later prompt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (later prompt)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (later prompt)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
